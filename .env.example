# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-in-production
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shadowhack
DB_USER=postgres
DB_PASSWORD=change-this-strong-password-in-production
DATABASE_URL=postgresql://postgres:change-this-strong-password-in-production@postgres:5432/shadowhack

# ============================================================================
# REDIS CONFIGURATION (Caching)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password-in-production
REDIS_URL=redis://:change-this-redis-password-in-production@redis:6379/0

# ============================================================================
# JWT CONFIGURATION (Authentication)
# ============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# ============================================================================
# THIRD-PARTY API KEYS
# ============================================================================
# Groq AI (for learning plans, games, analytics)
GROQ_API_KEY=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

# Bug Bounty Platforms
HACKERONE_API_KEY=your-hackerone-api-key
BUGCROWD_API_KEY=your-bugcrowd-api-key
INTIGRITI_API_KEY=your-intigriti-api-key

# ============================================================================
# OAUTH CONFIGURATION
# ============================================================================
# LinkedIn (for certificate sharing)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# GitHub (optional, for OAuth login)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google (optional, for OAuth login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@shadowhack.com
SENDER_NAME=ShadowHack

# ============================================================================
# AWS S3 CONFIGURATION (File Uploads)
# ============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=shadowhack-uploads
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com

# ============================================================================
# SENTRY CONFIGURATION (Error Tracking)
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# ============================================================================
# STRIPE CONFIGURATION (Payments, optional)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# APPLICATION URLs
# ============================================================================
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
MOBILE_APP_URL=https://app.shadowhack.com

# ============================================================================
# GOOGLE ANALYTICS & TRACKING
# ============================================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://shadowhack.com

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# SECURITY HEADERS
# ============================================================================
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_REGISTRATION=True
ENABLE_OAUTH=True
ENABLE_BUG_BOUNTY=True
ENABLE_MENTORSHIP=True
ENABLE_ANALYTICS=True
ENABLE_GAME_MODE=True
ENABLE_WIKI=True

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://:change-this-redis-password-in-production@redis:6379/1
CACHE_DEFAULT_TIMEOUT=300
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
LOG_FILE=/var/log/shadowhack/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
PROMETHEUS_ENABLED=True

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
VERSION=1.0.0
BUILD_ID=
DEPLOYMENT_DATE=
